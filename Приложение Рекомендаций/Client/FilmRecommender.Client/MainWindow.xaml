<Window x:Class="FilmRecommender.Client.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекомендательная система фильмов" Height="720" Width="1200"
        MinHeight="520" MinWidth="900" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="SelectionMode" Value="Single" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="AlternatingRowBackground" Value="#F4F6FA" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Панель пользователя -->
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Пользователь:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
            <ComboBox x:Name="UserCombo" Width="220" DisplayMemberPath="Username"
                      Margin="0,0,8,0" SelectionChanged="UserCombo_SelectionChanged" />
            <Button Content="Новый пользователь…" Click="NewUser_Click" />
        </StackPanel>

        <TabControl Grid.Row="1">

            <!-- 1. Топ-10 -->
            <TabItem Header="Топ-10 популярных">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить" Click="RefreshTop_Click" />
                    </StackPanel>
                    <DataGrid x:Name="TopGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" />
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" />
                            <DataGridTextColumn Header="Режиссёр" Binding="{Binding Director}" Width="*" />
                            <DataGridTextColumn Header="Актёр" Binding="{Binding Actor}" Width="*" />
                            <DataGridTextColumn Header="Актриса" Binding="{Binding Actress}" Width="*" />
                            <DataGridTextColumn Header="Популярность" Binding="{Binding Popularity}" />
                            <DataGridTextColumn Header="Ср. оценка" Binding="{Binding AvgRating, StringFormat={}{0:F2}}" />
                            <DataGridTextColumn Header="Оценок" Binding="{Binding RatingsCount}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 2. Рекомендации для пользователя -->
            <TabItem Header="Рекомендации для пользователя">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Персональные (гибрид)" Click="Personal_Click" />
                        <Button Content="По пользователям" Click="UserBased_Click" />
                        <Button Content="По фильмам" Click="ItemBased_Click" />
                        <TextBlock x:Name="RecTitle" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </StackPanel>
                    <DataGrid x:Name="RecGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" />
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" />
                            <DataGridTextColumn Header="Режиссёр" Binding="{Binding Director}" Width="*" />
                            <DataGridTextColumn Header="Релевантность" Binding="{Binding Score, StringFormat={}{0:F1}}" />
                            <DataGridTextColumn Header="Обоснование" Binding="{Binding Reason}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 3. Каталог и оценки -->
            <TabItem Header="Каталог и оценки">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="200" />
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox x:Name="SearchBox" Width="260" Padding="3" Margin="0,0,8,0" KeyDown="SearchBox_KeyDown" />
                        <ComboBox x:Name="GenreCombo" Width="160" Margin="0,0,8,0" />
                        <Button Content="Найти" Click="Search_Click" />
                    </StackPanel>

                    <DataGrid x:Name="FilmsGrid" Grid.Row="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" />
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" />
                            <DataGridTextColumn Header="Режиссёр" Binding="{Binding Director}" Width="*" />
                            <DataGridTextColumn Header="Актёр" Binding="{Binding Actor}" Width="*" />
                            <DataGridTextColumn Header="Актриса" Binding="{Binding Actress}" Width="*" />
                            <DataGridTextColumn Header="Мин." Binding="{Binding LengthMin}" />
                            <DataGridCheckBoxColumn Header="Награды" Binding="{Binding HasAwards, Mode=OneWay}" />
                            <DataGridTextColumn Header="Ср. оценка" Binding="{Binding AvgRating, StringFormat={}{0:F2}}" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,8">
                        <TextBlock Text="Ваша оценка:" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <ComboBox x:Name="RatingCombo" Width="60" Margin="0,0,8,0" SelectedIndex="4">
                            <ComboBoxItem Content="1" />
                            <ComboBoxItem Content="2" />
                            <ComboBoxItem Content="3" />
                            <ComboBoxItem Content="4" />
                            <ComboBoxItem Content="5" />
                        </ComboBox>
                        <Button Content="Оценить выбранный фильм" Click="Rate_Click" />
                        <Button Content="Похожие по контенту" Click="SimilarContent_Click" />
                        <Button Content="Похожие по оценкам" Click="SimilarRatings_Click" />
                    </StackPanel>

                    <GroupBox x:Name="SimilarGroup" Grid.Row="3" Header="Похожие фильмы">
                        <DataGrid x:Name="SimilarGrid" Margin="4">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                                <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" />
                                <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" />
                                <DataGridTextColumn Header="Сходство" Binding="{Binding Score, StringFormat={}{0:F1}}" />
                                <DataGridTextColumn Header="Обоснование" Binding="{Binding Reason}" Width="3*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <!-- 4. Мои оценки -->
            <TabItem Header="Мои оценки">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Обновить" Click="RefreshMyRatings_Click" />
                    </StackPanel>
                    <DataGrid x:Name="MyRatingsGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Title}" Width="2*" />
                            <DataGridTextColumn Header="Год" Binding="{Binding ReleaseYear}" />
                            <DataGridTextColumn Header="Жанр" Binding="{Binding Genre}" Width="*" />
                            <DataGridTextColumn Header="Оценка" Binding="{Binding Rating}" />
                            <DataGridTextColumn Header="Дата" Binding="{Binding RatedAt, StringFormat={}{0:dd.MM.yyyy HH:mm}}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- 5. Справка -->
            <TabItem Header="Справка">
                <DockPanel Margin="8">
                    <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8">
                        <Run FontWeight="SemiBold" Text="Как пользоваться приложением:" /><LineBreak />
                        1) Выберите пользователя вверху (или создайте нового). <LineBreak />
                        2) «Топ-10 популярных» - самые популярные фильмы. <LineBreak />
                        3) «Рекомендации для пользователя» - персональные (гибрид), по пользователям и по фильмам. <LineBreak />
                        4) «Каталог и оценки» - найдите фильм, выберите его в таблице, поставьте оценку 1-5
                        (сохраняется в БД) или посмотрите похожие фильмы по контенту / по оценкам. <LineBreak />
                        <LineBreak />
                        <Run FontWeight="SemiBold" Text="Команды API и их параметры:" />
                    </TextBlock>
                    <DataGrid x:Name="HelpGrid">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Метод" Binding="{Binding Method}" />
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Url}" Width="2*" />
                            <DataGridTextColumn Header="Параметры" Binding="{Binding Parameters}" Width="3*" />
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="3*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="StatusText" Text="Готово" />
        </StatusBar>
    </Grid>
</Window>
